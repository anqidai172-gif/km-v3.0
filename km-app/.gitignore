.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# Database files — never commit (settings table stores API key)
*.db
*.sqlite
*.sqlite3

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Tunnel tools
bore.exe
bore.zip
ngrok.exe
ngrok.zip
ngrok-out.log
ngrok-err.log

